DATABASE_URL=postgresql+psycopg://app:app_dev_password@postgres:5432/ecommerce
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Bootstrap admin, created by db/init_db.py seed on first run
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Super Admin

UPLOAD_DIR=/app/uploads

# New-order email notification (optional). If left blank, notifications are
# just logged instead of sent. For Gmail, use an app password, not your login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
NOTIFY_TO_EMAIL=

# Cloudflare R2 image storage (optional). If left blank, uploads are saved to
# local disk instead (fine for local dev, but most free hosts wipe local disk on restart).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
