DATABASE_URL=postgresql+psycopg://app:app_dev_password@postgres:5432/ecommerce
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Bootstrap admin, created by db/init_db.py seed on first run
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Super Admin

UPLOAD_DIR=/app/uploads
